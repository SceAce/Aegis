      "truncated": false
    },
    {
      "source_uri": "file:///Users/scemac/My_github/Aegis/knowledge/techniques/cards/crypto-dlog-smooth-order.md",
      "source_kind": "local_document",
      "verified": false,
      "action_policy": "none",
      "source_digest": "sha256:e43f4569ae3d70feb260402174a298172bfd7a85aefbccb64fd75c1efcd83a2a",

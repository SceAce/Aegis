      ],
      "content": "Expect",
      "line_start": 22,
      "line_end": 22,
      "truncated": false
    },
    {
      "source_uri": "file:///Users/scemac/My_github/Aegis/knowledge/techniques/cards/pwn-heap-tcache-uaf.md",

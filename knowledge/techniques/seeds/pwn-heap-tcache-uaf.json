      "kind": "paragraph",
      "topic": "堆：UAF / tcache 投毒",
      "section": [
        "堆：UAF / tcache 投毒",
        "When"
      ],
      "content": "存在 use-after-free/double-free；能控制 chunk 内容；glibc 版本已知或可泄。",
      "line_start": 14,
      "line_end": 14,
      "truncated": false
    },

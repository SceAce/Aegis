      "kind": "paragraph",
      "topic": "CBC padding oracle",
      "section": [
        "CBC padding oracle",
        "Expect"
      ],
      "content": "恢复出的明文重新加密/校验一致；padding 始终合法。",
      "line_start": 20,
      "line_end": 20,
      "truncated": false
    },

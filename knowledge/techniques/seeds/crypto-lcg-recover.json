        "Expect"
      ],
      "content": "Expect",
      "line_start": 21,
      "line_end": 21,
      "truncated": false
    },
    {
      "source_uri": "file:///Users/scemac/My_github/Aegis/knowledge/techniques/cards/crypto-lcg-recover.md",

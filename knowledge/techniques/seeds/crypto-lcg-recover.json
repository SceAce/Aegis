      "kind": "paragraph",
      "topic": "LCG 参数恢复与预测",
      "section": [
        "LCG 参数恢复与预测",
        "Expect"
      ],
      "content": "重放已知序列完全一致，预测值与下一组观测一致。",
      "line_start": 22,
      "line_end": 22,
      "truncated": false
    },

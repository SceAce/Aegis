      "kind": "paragraph",
      "topic": "LCG 参数恢复与预测",
      "section": [
        "LCG 参数恢复与预测",
        "When"
      ],
      "content": "输出满足 x_{i+1} = (a*x_i + c) mod m；参数或高位/低位可能部分未知。",
      "line_start": 13,
      "line_end": 13,
      "truncated": false
    },

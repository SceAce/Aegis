      "kind": "paragraph",
      "topic": "反调试识别与绕过",
      "section": [
        "反调试识别与绕过",
        "Expect"
      ],
      "content": "断点能停在目标逻辑，程序不再因调试器退出。",
      "line_start": 21,
      "line_end": 21,
      "truncated": false
    },

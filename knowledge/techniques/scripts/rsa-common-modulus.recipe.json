{
  "id": "crypto-common-modulus",
  "version": 1,
  "description": "同一 n、不同 e 时恢复明文（要求 gcd(e1,e2)=1）",
  "executable": "/opt/homebrew/Cellar/python@3.14/3.14.7/Frameworks/Python.framework/Versions/3.14/bin/python3.14",
  "script": "/Users/scemac/My_github/Aegis/knowledge/techniques/scripts/rsa-common-modulus.py",
  "argv": [
    "{script}",
    "{out}",
    "{n}",
    "{e1}",
    "{c1}",
    "{e2}",
    "{c2}"
  ],
  "workspace": "/tmp/at-test",
  "parameters": {
    "out": {
      "type": "string",
      "required": true,
      "direction": "out"
    },
    "n": {
      "type": "string",
      "required": true
    },
    "e1": {
      "type": "string",
      "required": true
    },
    "c1": {
      "type": "string",
      "required": true
    },
    "e2": {
      "type": "string",
      "required": true
    },
    "c2": {
      "type": "string",
      "required": true
    }
  },
  "verify": {
    "kind": "json_post_state",
    "resource": "out",
    "checks": [
      {
        "path": "verified",
        "op": "eq",
        "value": true
      },
      {
        "path": "plaintext",
        "op": "exists"
      }
    ]
  },
  "category": "crypto",
  "notes": "仅当 gcd(e1,e2)=1 时适用；不满足时脚本以退出码 3 失败，不会写出成功形状的结果。",
  "examples": [
    {
      "arguments": {
        "n": "0x…",
        "e1": "65537",
        "c1": "0x…",
        "e2": "17",
        "c2": "0x…",
        "out": "cm-out.json"
      },
      "note": "所有数值都是十进制或 0x 前缀的十六进制字符串"
    }
  ],
  "timeout_ms": 20000
}

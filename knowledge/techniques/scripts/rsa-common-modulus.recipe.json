{
  "id": "crypto-common-modulus",
  "version": 1,
  "description": "同一 n、不同 e 时恢复明文（要求 gcd(e1,e2)=1）",
  "executable": "/Users/scemac/Tools/PyVenv/CTF/bin/python3",
  "script": "/Users/scemac/My_github/Aegis/knowledge/techniques/scripts/rsa-common-modulus.py",
  "argv": [
    "{script}",
    "{out}",
    "{n}",
    "{e1}",
    "{c1}",
    "{e2}",
    "{c2}"
  ],
  "workspace": "/tmp/at-test",
  "parameters": {
    "out": {
      "type": "string",
      "required": true,
      "direction": "out"
    },
    "n": {
      "type": "string",
      "required": true
    },
    "e1": {
      "type": "string",
      "required": true
    },
    "c1": {
      "type": "string",
      "required": true
    },
    "e2": {
      "type": "string",
      "required": true
    },
    "c2": {
      "type": "string",
      "required": true
    }
  },
  "verify": {
    "kind": "json_post_state",
    "resource": "out",
    "checks": [
      {
        "path": "verified",
        "op": "eq",
        "value": true
      },
      {
        "path": "plaintext",
        "op": "exists"
      }
    ]
  }
}

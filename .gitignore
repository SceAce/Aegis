# Local experiment state — never push
.aegis/
runs/
raw/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Pi runtime leftovers (keep settings + extensions)
.pi/*
!.pi/settings.json
!.pi/extensions/
!.pi/extensions/**

# Vendored pi fork: has its own git and a 281M node_modules. See vendor/README.md
# for what we changed and how to rebuild it. Not tracked here on purpose — the
# changes are documented, not vendored as history.
vendor/pi/

# Embedded pi repo inside Pi_Agent_base: own git history + 478M node_modules.
# Never track it here.
Pi_Agent_base/pi/

# Knowledge is local and portable; the repository has no knowledge/ tree.
# Keep an accidental recreation ignored so a stale checkout can never shadow
# the operator's corpus under $AEGIS_HOME/knowledge/.
/knowledge/

# Local scratch
tmp/

# OS
.DS_Store

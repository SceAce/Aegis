# Local experiment state — never push
.aegis/
runs/
raw/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Pi runtime leftovers (keep settings + extensions)
.pi/*
!.pi/settings.json
!.pi/extensions/
!.pi/extensions/**

# Vendored pi fork: has its own git and a 281M node_modules. See vendor/README.md
# for what we changed and how to rebuild it. Not tracked here on purpose — the
# changes are documented, not vendored as history.
vendor/pi/

# Embedded pi repo inside Pi_Agent_base: own git history + 478M node_modules.
# Never track it here.
Pi_Agent_base/pi/

# Knowledge is local and portable; never push Wiki documents, seeds or indexes
# (third-party content, tens of MB). The curated technique cards under
# knowledge/techniques/ ARE tracked: they are our own artifacts and they carry
# the card contract in docs/TECHNIQUE_CARD_SCHEMA.md. Their sources and the
# compiled JSON are produced by knowledge/techniques/build_cards.py.
/knowledge/*
!/knowledge/techniques/
!/knowledge/techniques/**

# Local scratch
tmp/

# OS
.DS_Store

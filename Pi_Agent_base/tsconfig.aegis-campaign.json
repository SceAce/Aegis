{
	// Aegis-owned type-check config for the Campaign product module set.
	//
	// The Campaign layer is author-JS with JSDoc in .mjs files. This config
	// checks the same modules after relocation with `checkJs` on, using the same structural
	// settings as `tsconfig.aegis.json` (non-strict to avoid flooding tsc with
	// implicit-any from the untyped pre-existing runtime it imports). It is
	// DELIBERATELY separate from the Batch-E config so Batch-E coverage is never
	// claimed for the Campaign. It does NOT include Pi's own sources.
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2024"],
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowJs": true,
		"checkJs": true,
		"types": ["node"],
		"typeRoots": ["./pi/node_modules/@types"]
	},
	"include": [
		"verification/aggregate.mjs",
		"execution/broker-worker.mjs",
		"campaign/campaign-mode.mjs",
		"campaign/c3-entry.mjs",
		"campaign/c5-entry.mjs",
		"campaign/c6-entry.mjs",
		"campaign/e1-max-pilot.mjs",
		"memory/c6-learning.mjs",
		"campaign/c6-model-worker.mjs",
		"campaign/c6-request-lifecycle.mjs",
		"campaign/c6-runner.mjs",
		"campaign/c6-sdk-runtime.mjs",
		"campaign/c6-tool-ledger.mjs",
		"observation/e1-observation.mjs",
		"campaign/e1-plan-contract.mjs",
		"campaign/e1-planning.mjs",
		"campaign/e1-task-graph.mjs",
		"execution/adapters/code-repair-adapter.mjs",
		"campaign/provider-config.mjs",
		"verification/registered-test.mjs",
		"execution/adapters/structured-data-adapter.mjs",
		"campaign/campaign-config.mjs",
		"campaign/dynamic-policy.mjs",
		"campaign/event-contract.mjs",
		"campaign/fixture.mjs",
		"execution/adapters/fixture-adapter.mjs",
		"campaign/host.mjs",
		"verification/host-oracle.mjs",
		"campaign/identifiers.mjs",
		"campaign/index.mjs",
		"campaign/manifest.mjs",
		"campaign/ownership.mjs",
		"campaign/projection.mjs",
		"campaign/queue.mjs",
		"campaign/registries.mjs",
		"observation/report.mjs",
		"observation/observation-command.mjs",
		"observation/observation-server.mjs",
		"observation/observation-view.mjs",
		"observation/report-entry.mjs",
		"observation/report-export.mjs",
		"campaign/scheduler.mjs",
		"execution/adapters/script-workspace-adapter.mjs"
	],
	"exclude": ["pi/**", "node_modules/**", "tests/**"]
}
